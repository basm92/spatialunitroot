Package: spatialunitroot
Type: Package
Title: Spatial Unit Root Diagnostic Tests and Transformations
Version: 0.1.0
Authors@R: c(
    person("Sascha O.", "Becker", role = "aut",
           comment = "Original Stata code"),
    person("P. David", "Boll", role = c("aut", "cre"),
           email = "david.boll@warwick.ac.uk",
